{
  "$id": "usuario",
  "title": "GetUserResult (GET /Account/v1/User/{UUID} → 200)",
  "type": "object",
  "required": ["userId", "username", "books"],
  "additionalProperties": false,
  "properties": {
    "userId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "username": { "type": "string", "minLength": 1 },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "isbn",
          "title",
          "subTitle",
          "author",
          "publish_date",
          "publisher",
          "pages",
          "description",
          "website"
        ],
        "properties": {
          "isbn": { "type": "string", "pattern": "^\\d{13}$" },
          "title": { "type": "string" },
          "subTitle": { "type": "string" },
          "author": { "type": "string" },
          "publish_date": { "type": "string" },
          "publisher": { "type": "string" },
          "pages": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "website": { "type": "string" }
        }
      }
    }
  }
}
