{
  "$id": "token",
  "title": "TokenViewModel (POST /Account/v1/GenerateToken)",
  "type": "object",
  "required": ["token", "expires", "status", "result"],
  "additionalProperties": false,
  "properties": {
    "token": { "type": ["string", "null"] },
    "expires": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "status": { "enum": ["Success", "Failed"] },
    "result": { "type": "string" }
  }
}
