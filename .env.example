# Copia este archivo como `.env` y ajusta los valores. `.env` está ignorado por git:
# nunca subas credenciales reales. En CI, define estas variables como secrets.

# Ambiente de ejecución: dev | qa | prod (por defecto: prod).
# Los scripts `npm run test:<ambiente>` lo fijan con --expose y tienen prioridad.
TEST_ENV=prod

# Opcional: sobrescribe la baseUrl del ambiente elegido.
# BASE_URL=https://demoqa.com

# Credenciales del Book Store de DemoQA (secretos, se leen con cy.env()).
# Aún no las usa ningún test; quedan preparadas para los escenarios de Book Store.
BOOK_USER=usuario_demo
BOOK_PASS=CambiaMe123!
