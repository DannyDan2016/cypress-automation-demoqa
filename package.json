{
  "name": "cypress-automation-demoqa",
  "version": "1.0.0",
  "private": true,
  "description": "Suite E2E con Cypress, Cucumber (BDD en español), Page Object Model y datos en YAML sobre DemoQA (portfolio de QA Automation).",
  "keywords": [
    "cypress",
    "e2e",
    "qa",
    "automation",
    "bdd",
    "cucumber",
    "gherkin",
    "page-object-model",
    "demoqa"
  ],
  "author": "Danny Parrado",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DannyDan2016/cypress-automation-demoqa.git"
  },
  "bugs": {
    "url": "https://github.com/DannyDan2016/cypress-automation-demoqa/issues"
  },
  "homepage": "https://github.com/DannyDan2016/cypress-automation-demoqa#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:smoke": "cypress run --expose \"tags=@smoke and not @known-bug\"",
    "test:regression": "cypress run --expose \"tags=@regression and not @known-bug\"",
    "test:known-bugs": "cypress run --expose tags=@known-bug",
    "test:dev": "cypress run --expose TEST_ENV=dev",
    "test:qa": "cypress run --expose TEST_ENV=qa",
    "test:staging": "cypress run --expose TEST_ENV=staging",
    "test:prod": "cypress run --expose TEST_ENV=prod",
    "test:unit": "node --test \"config/**/*.test.js\"",
    "test:docker": "docker compose run --rm --build e2e",
    "test:docker:smoke": "docker compose run --rm --build -e \"TAGS=@smoke and not @known-bug\" e2e",
    "cy:open": "cypress open",
    "lint": "eslint . && npm run lint:features",
    "lint:features": "node scripts/validar-tags.js",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@eslint/js": "10.0.1",
    "cypress": "16.1.1",
    "dotenv": "18.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.2",
    "globals": "17.12.0",
    "js-yaml": "5.4.2",
    "prettier": "3.9.9"
  }
}
